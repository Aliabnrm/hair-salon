{
  "name": "@hair-salon/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.build.json && tsc -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src test vitest.config.ts vitest.config.e2e.ts vitest.config.integration.ts drizzle.config.ts",
    "format": "prettier --write src test drizzle *.ts *.json .prettierrc.json",
    "format:check": "prettier --check src test drizzle *.ts *.json .prettierrc.json",
    "test": "vitest run --config vitest.config.ts",
    "test:e2e": "pnpm run build && vitest run --config vitest.config.e2e.ts",
    "db:up": "docker compose -f ../compose.yml up -d --wait",
    "db:down": "docker compose -f ../compose.yml down",
    "db:migrate": "pnpm run build && node dist/database/migrate.js",
    "test:integration": "pnpm run build && vitest run --config vitest.config.integration.ts"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-express": "12.3.2",
    "@nestjs/swagger": "12.0.5",
    "argon2": "0.45.1",
    "dotenv": "18.0.9",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@nestjs/testing": "12.3.2",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "drizzle-kit": "0.31.11",
    "oxlint": "1.90.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "6.0.2",
    "vitest": "4.1.12"
  }
}
