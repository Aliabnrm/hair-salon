{
  "name": "hair-salon",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "pnpm@12.16.1",
  "scarfSettings": {
    "enabled": false
  },
  "scripts": {
    "dev": "pnpm --filter @hair-salon/api run start:dev",
    "start": "pnpm --filter @hair-salon/api run start",
    "build": "pnpm --recursive --workspace-concurrency=1 run build",
    "typecheck": "pnpm --recursive --workspace-concurrency=1 run typecheck",
    "lint": "pnpm --recursive --workspace-concurrency=1 run lint",
    "format": "pnpm --recursive --workspace-concurrency=1 run format",
    "format:check": "pnpm --recursive --workspace-concurrency=1 run format:check",
    "test": "pnpm --recursive --workspace-concurrency=1 run test",
    "test:e2e": "pnpm --filter @hair-salon/api run test:e2e",
    "check": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run test:e2e && pnpm run test:integration && pnpm run test:browser",
    "db:up": "pnpm --filter @hair-salon/api run db:up",
    "db:down": "pnpm --filter @hair-salon/api run db:down",
    "db:migrate": "pnpm --filter @hair-salon/api run db:migrate",
    "test:integration": "pnpm --filter @hair-salon/api run test:integration",
    "dev:frontend": "pnpm --filter @hair-salon/frontend run dev",
    "test:browser": "pnpm --filter @hair-salon/frontend run test:browser"
  }
}
